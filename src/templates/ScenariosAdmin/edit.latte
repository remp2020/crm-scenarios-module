{block #title}{if $scenario}{_scenarios.admin.scenarios.edit.title}{else}{_scenarios.admin.scenarios.new.title}{/if}{/block}

{block #head}
    <script type="module" crossorigin src="/layouts/admin/scenario-builder/index.js?v=3"></script>
    <link rel="stylesheet" crossorigin href="/layouts/admin/scenario-builder/index.css?v=3">
    <style>
        #admin_container {
            padding: 0;
        }

        body > .navbar {
            margin-bottom: 0;
        }
    </style>
    <script>
        window.Scenario = {
            config: {
                CRM_HOST: {$crmHost},
                SCENARIO_ID: {if $scenario}{$scenario->id}{else}null{/if},
                BANNER_ENABLED: {$bannerEnabled},
                PUSH_NOTIFICATION_ENABLED: {$pushNotificationEnabled}
            }
        };
    </script>
{/block}

{block #content}

<div style="display: flex; width: 100%; height: calc(100vh - 160px); min-height: 480px; flex-direction: column; overflow: hidden;">
    <div id="scenario-editor-root"
         style="flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; overflow: hidden; background-color: #fafafa">
    </div>
</div>